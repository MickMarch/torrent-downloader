# API authentication
# The key callers (the orchestrator) must send in X-API-Key.
API_KEY=

# qBittorrent Web UI
# Use 127.0.0.1 when running directly on the host.
# Use host.docker.internal when running inside a Docker container.
QB_HOST=127.0.0.1
QB_PORT=8080
QB_API_KEY=

# TMDB v3 API
TMDB_API_KEY=

# Search behaviour
# TARGET_LANGUAGE is an ISO 639-1 code; it drives TMDB metadata and the audio
# language filter. AUDIO_LANGUAGE_FILTER: lenient (default) drops releases
# explicitly tagged with another language unless they are multi-audio;
# strict also drops untagged releases; off only shows the tags.
TARGET_LANGUAGE=en
AUDIO_LANGUAGE_FILTER=lenient
MINIMUM_SEEDERS=10
SEARCH_TIMEOUT_SECONDS=15

# Cache
CACHE_DIRECTORY=.cache
CACHE_EXPIRATION_SECONDS=3600

# API server (defaults shown)
# 0.0.0.0 binds all interfaces, required in Docker. Use 127.0.0.1 to restrict
# a bare-host deployment to localhost.
API_HOST=0.0.0.0
API_PORT=8000

# Media library base path
# Host-side media root. qBittorrent (running on the host, not in this
# container) saves into the staging subdir under it: F:\Media ->
# F:\Media\_incoming\Movies or \_incoming\Shows by media_type. The
# orchestrator moves finished downloads into F:\Media\Movies or \Shows.
# This is a host path even when torrent-downloader runs in a container,
# since save_path is sent to qBittorrent's host-side API, not used locally.
MEDIA_HOST_PATH=F:\Media

# VPN interface allowlist (fail-closed)
# Comma-separated network interface names qBittorrent may be bound to.
# Downloads are rejected unless qBittorrent's bound interface matches one of
# these (case-insensitive). Bring your own VPN: use the interface name exactly
# as it appears in qBittorrent under
# Tools > Preferences > Advanced > Network interface.
# Leaving this EMPTY blocks all downloads. It never means "allow any".
VPN_INTERFACES=NordLynx
