# API authentication
# The key callers (the orchestrator) must send in X-API-Key.
API_KEY=

# qBittorrent Web UI
# In the compose stack this service shares gluetun's network namespace with
# qBittorrent, so it is reached on loopback. Use host.docker.internal only
# for a host-installed qBittorrent reached from a container.
QB_HOST=127.0.0.1
QB_PORT=8080
# API key generated in qBittorrent (Preferences > WebUI > API Key), or
# pre-seeded by the workspace provision script.
QB_API_KEY=

# TMDB v3 API
TMDB_API_KEY=

# Search behaviour
# TARGET_LANGUAGE is an ISO 639-1 code; it drives TMDB metadata and the audio
# language filter. AUDIO_LANGUAGE_FILTER: lenient (default) drops releases
# explicitly tagged with another language unless they are multi-audio;
# strict also drops untagged releases; off only shows the tags.
TARGET_LANGUAGE=en
AUDIO_LANGUAGE_FILTER=lenient
MINIMUM_SEEDERS=10
SEARCH_TIMEOUT_SECONDS=15
# Pattern searches run in parallel, up to this many at once.
SEARCH_CONCURRENCY=4

# Cache
CACHE_DIRECTORY=.cache
CACHE_EXPIRATION_SECONDS=3600
# Trending, by-genre and genre lists from TMDB (one hour to seven days).
DISCOVER_CACHE_SECONDS=86400
# Runtime setting overrides made through the API persist here (same volume
# as the cache). Search behaviour values above are the defaults they override.
SETTINGS_PATH=.cache/settings.json

# API server
# 0.0.0.0 binds all interfaces, required in Docker. Use 127.0.0.1 to restrict
# a bare-host deployment to localhost. Inside gluetun's namespace port 8000
# belongs to gluetun's control server, so this service listens on 8001 and
# the orchestrator reaches it as http://gluetun:8001.
API_HOST=0.0.0.0
API_PORT=8001

# Media library mount
# In-container path of the media root. The same host directory is bind
# mounted at this path into qBittorrent, the orchestrator and this service,
# so save paths need no host translation. Downloads go to the staging subdir
# by media type: /media/_incoming/Movies or /media/_incoming/Shows. The
# orchestrator moves finished downloads into /media/Movies or /media/Shows.
MEDIA_MOUNT_PATH=/media

# VPN interface allowlist (fail-closed)
# Comma-separated network interface names qBittorrent may be bound to.
# Downloads are rejected unless qBittorrent's bound interface matches one of
# these (case-insensitive). Inside gluetun's namespace the WireGuard tunnel
# is always tun0, whatever the provider. A host install lists the adapter
# name shown in qBittorrent under Tools > Preferences > Advanced > Network
# interface instead.
# Leaving this EMPTY blocks all downloads. It never means "allow any".
VPN_INTERFACES=tun0
